# ── 필수 ─────────────────────────────────────────────
# Gemini API 키 (영상 분석 · 캡션/해시태그 작성) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Mirra API 키 — Mirra 워크스페이스 설정 → API 키
MIRRA_API_KEY=

# ── 선택 ─────────────────────────────────────────────
# 기본으로 선택될 "지정된 계정" (쉼표 구분: username, 표시 이름, 계정 ID, platform:username)
# 예) MIRRA_DEFAULT_ACCOUNTS=instagram:thank_cafe,youtube:thankstudio
MIRRA_DEFAULT_ACCOUNTS=
MIRRA_BASE_URL=https://www.mirra.my
GEMINI_MODEL=gemini-3-flash-preview
CAPTION_LANGUAGE=한국어
HASHTAG_COUNT=15
# YouTube 공개 범위: public | unlisted | private
MIRRA_YOUTUBE_PRIVACY=public
# TikTok 공개 범위: PUBLIC_TO_EVERYONE | MUTUAL_FOLLOW_FRIENDS | FOLLOWER_OF_CREATOR | SELF_ONLY
MIRRA_TIKTOK_PRIVACY=PUBLIC_TO_EVERYONE
PORT=5180
